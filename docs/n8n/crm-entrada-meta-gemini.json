    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Junta el mensaje con el archivo descargado (que llega por la entrada de este nodo).\nconst base = $('¿Tiene archivo?').item.json;\nlet up = {};\ntry { up = $('Pedir URL de subida').item.json || {}; } catch (e) {}\nlet bin = $input.item.binary?.data ?? null;\n\nconst crm = { ...base.crm };\ncrm.media_url = bin && up.public_url ? up.public_url : null;\nconst out = { json: { ...base, crm, download_failed: !bin } };\nif (bin) {\n  const mime = String(bin.mimeType || crm.media_mime_type || 'application/octet-stream').split(';')[0].trim();\n  crm.media_mime_type = mime;\n  out.binary = { ...$input.item.binary, data: { ...bin, mimeType: mime } };\n}\nreturn out;"
      },
