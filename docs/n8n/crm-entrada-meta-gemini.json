    {
      "parameters": {
        "jsCode": "// ================== CONFIGURACIÓN DEL CLIENTE ==================\nconst CONFIG = {\n  crm_url: 'https://crm.aikonintelligence.com',\n  tenant_id: 'PEGAR_TENANT_ID_DEL_CLIENTE',\n  webhook_secret: 'PEGAR_SECRETO_COMPARTIDO',\n  // Webhook del bot de ESTE cliente (puede estar en otro n8n)\n  bot_webhook_url: 'PEGAR_URL_DEL_WEBHOOK_DEL_BOT',\n};\n// ===============================================================\n\n// Convierte el formato de Meta al formato estándar del CRM.\nconst out = [];\nfor (const item of $input.all()) {\n  const v = item.json;\n  for (const s of v.statuses ?? []) {\n    out.push({ json: { kind: 'status', config: CONFIG, crm: {\n      action: 'message_status',\n      tenant_id: CONFIG.tenant_id,\n      wa_message_id: s.id,\n      status: s.status,\n      error_code: s.errors?.[0]?.code ? String(s.errors[0].code) : null,\n      error_message: s.errors?.[0]?.title ?? s.errors?.[0]?.message ?? null,\n    } } });\n  }\n  for (const m of v.messages ?? []) {\n    const profile = (v.contacts ?? []).find((c) => c.wa_id === m.from);\n    let content = null;\n    let contentType = m.type;\n    let buttonText = null;\n    let buttonPayload = null;\n    switch (m.type) {\n      case 'text': content = m.text?.body ?? null; break;\n      case 'image': case 'video': case 'document': case 'audio': case 'sticker':\n        content = m[m.type]?.caption ?? null;\n        break;\n      case 'location': content = m.location ? m.location.latitude + ',' + m.location.longitude : null; break;\n      case 'reaction': content = m.reaction?.emoji ?? null; break;\n      case 'button':\n        buttonText = m.button?.text ?? null; buttonPayload = m.button?.payload ?? null;\n        content = buttonText; contentType = 'text';\n        break;\n      case 'interactive':\n        buttonText = m.interactive?.button_reply?.title ?? m.interactive?.list_reply?.title ?? null;\n        buttonPayload = m.interactive?.button_reply?.id ?? m.interactive?.list_reply?.id ?? null;\n        content = buttonText; contentType = 'text';\n        break;\n      default: contentType = 'text'; content = '[' + m.type + ']';\n    }\n    const media = ['image', 'video', 'document', 'audio', 'sticker'].includes(m.type) ? m[m.type] ?? {} : {};\n    out.push({ json: { kind: 'message', config: CONFIG, media_id: media.id ?? null, crm: {\n      action: 'inbound_message',\n      tenant_id: CONFIG.tenant_id,\n      wa_id: m.from,\n      contact_name: profile?.profile?.name ?? null,\n      wa_message_id: m.id,\n      content,\n      content_type: contentType,\n      button_text: buttonText,\n      button_payload: buttonPayload,\n      media_mime_type: media.mime_type ?? null,\n      media_filename: m.document?.filename ?? null,\n    } } });\n  }\n}\nreturn out;"
      },
